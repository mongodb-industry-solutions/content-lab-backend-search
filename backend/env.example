# Copy this file to backend/.env and fill in real values.
# mv backend/env.example backend/.env   (or: cp backend/env.example backend/.env)

# ---- MongoDB ----
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net  # Atlas connection string
DATABASE_NAME=contentlab                                     # Database name to connect to
APP_NAME=contentlab-search                                   # appName reported to MongoDB (shows up in Atlas logs/metrics)

# ---- Collection names (defaults shown match the code's fallbacks) ----
NEWS_COLLECTION=news                       # Scraped news articles + embeddings
REDDIT_COLLECTION=reddit_posts             # Scraped Reddit posts + embeddings
SUGGESTION_COLLECTION=suggestions          # AI-generated topic suggestions
USER_PROFILES_COLLECTION=userProfiles      # Declared for parity with deploy config; collection name is currently hardcoded in routers/content.py
DRAFTS_COLLECTION=drafts                   # Declared for parity with deploy config; collection name is currently hardcoded in routers/drafts.py
PREVIEW_COLLECTION=preview                 # Declared for parity with deploy config; collection name is currently hardcoded in routers/drafts.py

# ---- Grove (chat inference - Anthropic Messages API shape) ----
GROVE_API_KEY=your_grove_api_key                                                     # Sent as the api-key header (Azure APIM auth, NOT Anthropic's x-api-key)
GROVE_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/anthropic  # Grove gateway base URL
GROVE_CHAT_MODEL=claude-haiku-4-5                                                     # Model id passed in the request body

# ---- Voyage (embeddings - OpenAI-compatible shape, 1024-dim output) ----
EMBEDDINGS_URL=https://ai.mongodb.com          # Voyage embeddings endpoint base URL
VOYAGE_API_KEY=your_voyage_api_key             # Sent as "Authorization: Bearer <key>"; omitted entirely if blank
VOYAGE_EMBEDDING_MODEL=voyage-4-large          # Embedding model id

# ---- NewsAPI ----
NEWSAPI_KEY=your_newsapi_key   # https://newsapi.org

# ---- Firecrawl (used by the news scraper for full-page content) ----
FIRECRAWL_API_KEY=your_firecrawl_api_key

# ---- Reddit (PRAW) ----
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=contentlab-search/0.1 by your_reddit_username

# ---- Tavily (primary topic research; Grove is the LLM fallback) ----
TAVILY_API_KEYS=your_tavily_key1,your_tavily_key2   # Comma-separated; rotated through on failure

# ---- Runtime ----
NODE_ENV=dev   # "dev" | "staging" | "prod" - scheduled jobs only run when this is "prod"
