# Copy to backend/.env and fill in.

# ---- MongoDB ----
MONGODB_URI=
DATABASE_NAME=contentlab
APP_NAME=contentlab-search

# ---- Collections ----
NEWS_COLLECTION=news
REDDIT_COLLECTION=reddit_posts
SUGGESTION_COLLECTION=suggestions

# ---- Grove (chat) ----
# Sent as the `api-key` header, not Anthropic's `x-api-key`.
GROVE_API_KEY=
GROVE_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/anthropic
GROVE_CHAT_MODEL=claude-haiku-4-5

# ---- Voyage (embeddings, 1024-dim) ----
EMBEDDINGS_URL=https://ai.mongodb.com
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-4-large

# ---- Scrapers / search ----
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_USER_AGENT=
TAVILY_API_KEYS=

# Scheduled jobs only run when this is "prod".
NODE_ENV=dev
